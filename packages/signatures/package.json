{
  "name": "okf-signatures",
  "version": "1.0.0",
  "description": "Optional Ed25519 integrity manifests for OKF bundles",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disusered/okf-toolkit.git",
    "directory": "packages/signatures"
  },
  "homepage": "https://github.com/disusered/okf-toolkit#readme",
  "bugs": {
    "url": "https://github.com/disusered/okf-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-vectors": {
      "types": "./dist/test-vectors.d.ts",
      "default": "./dist/test-vectors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "okf-core": "workspace:*"
  }
}
