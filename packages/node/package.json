{
  "name": "okf-node",
  "version": "1.0.0-rc.0",
  "description": "Confined filesystem adapter and local change operations for OKF bundles",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/disusered/okf-toolkit.git", "directory": "packages/node" },
  "homepage": "https://github.com/disusered/okf-toolkit#readme",
  "bugs": { "url": "https://github.com/disusered/okf-toolkit/issues" },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "okf-contracts": "workspace:*",
    "okf-core": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
