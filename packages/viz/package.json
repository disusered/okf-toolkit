{
  "name": "okf-viz",
  "version": "2.1.0",
  "description": "Graph projection and browser rendering for an analyzed OKF bundle",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disusered/okf-toolkit.git",
    "directory": "packages/viz"
  },
  "homepage": "https://github.com/disusered/okf-toolkit#readme",
  "bugs": {
    "url": "https://github.com/disusered/okf-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "okf-contracts": "workspace:*"
  },
  "peerDependencies": {
    "cytoscape": "^3.34.1"
  },
  "devDependencies": {
    "@types/cytoscape": "3.31.0",
    "cytoscape": "3.34.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "okf",
    "knowledge-graph",
    "visualization"
  ]
}
