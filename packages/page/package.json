{
  "name": "okf-page",
  "version": "1.0.0",
  "description": "Deterministic, self-contained HTML page for an analyzed OKF bundle",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disusered/okf-toolkit.git",
    "directory": "packages/page"
  },
  "homepage": "https://github.com/disusered/okf-toolkit#readme",
  "bugs": {
    "url": "https://github.com/disusered/okf-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "pnpm vendor && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "pnpm vendor && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "pnpm vendor && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "okf-contracts": "workspace:*",
    "okf-viz": "workspace:*"
  },
  "devDependencies": {
    "cytoscape": "3.34.1",
    "dompurify": "3.4.13",
    "marked": "18.0.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "okf",
    "knowledge-graph",
    "visualization",
    "html"
  ]
}
