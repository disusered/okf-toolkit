{
  "name": "@disusered/okf-cli",
  "version": "1.2.0",
  "description": "Command line for OKF bundles, including the self-contained HTML page",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disusered/okf-toolkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/disusered/okf-toolkit#readme",
  "bugs": {
    "url": "https://github.com/disusered/okf-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "okf": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "pnpm vendor && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "pnpm vendor && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "pnpm vendor && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "okf-contracts": "workspace:*",
    "okf-core": "workspace:*",
    "okf-node": "workspace:*",
    "okf-viz": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "cytoscape": "3.34.1",
    "dompurify": "3.4.13",
    "marked": "18.0.10",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
