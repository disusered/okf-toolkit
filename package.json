{
  "name": "okf-toolkit-workspace",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.28.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disusered/okf-toolkit.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test scripts/test/release.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm release:verify",
    "pack:release": "node scripts/pack-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
